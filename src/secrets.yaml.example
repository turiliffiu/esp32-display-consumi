# Copia questo file in secrets.yaml e compila con i tuoi dati reali
# secrets.yaml è escluso da git (.gitignore) - non committarlo mai

wifi_ssid: "NOME_RETE_WIFI"
wifi_password: "PASSWORD_WIFI"

# Genera con: esphome secrets  (oppure un base64 casuale a 32 byte)
api_encryption_key: "GENERA_CHIAVE_32_BYTE_BASE64"

# Password a tua scelta per aggiornamenti OTA
ota_password: "SCEGLI_UNA_PASSWORD"
